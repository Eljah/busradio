[Unit]
Description=BusRadio playlist server
After=network.target
[Service]
User=busradio
Group=busradio
WorkingDirectory=/var/lib/busradio
EnvironmentFile=/etc/busradio/server.env
ExecStart=/usr/bin/java -Xmx512m -jar /opt/busradio/busradio.jar server /etc/busradio/server.properties
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/busradio
UMask=0077
[Install]
WantedBy=multi-user.target
